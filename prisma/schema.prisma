generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  ORGANIZATION_ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Fulfilment workflow: PENDING → PROCESSING → SHIPPED → DELIVERED, with
/// CANCELLED reachable from PENDING or PROCESSING. Payment is tracked
/// separately in PaymentStatus. (The former FULFILLED value was migrated to
/// DELIVERED.)
enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContactMessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum SubscriberStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

enum NavigationLocation {
  HEADER
  FOOTER
}

enum OutfitOptionType {
  BODY_TYPE
  SKIN_TONE
  OCCASION
}

// ---------------------------------------------------------------------------
// Platform / tenancy
// ---------------------------------------------------------------------------

/// A fashion business/organization using the platform. The tenant boundary:
/// every organization-owned row below carries an organizationId and all
/// queries must be scoped to it.
model Organization {
  id           String             @id @default(cuid())
  name         String
  slug         String             @unique
  description  String?
  logoUrl      String?
  contactEmail String?
  contactPhone String?
  address      String?
  status       OrganizationStatus @default(ACTIVE)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  admin      User?
  categories Category[]
  products   Product[]
  customers  Customer[]
  orders     Order[]
  storefront StorefrontConfig?
  settings   OrganizationSettings?

  variants              ProductVariant[]
  navigationLinks       NavigationLink[]
  pageContents          PageContent[]
  teamMembers           TeamMember[]
  blogCategories        BlogCategory[]
  blogPosts             BlogPost[]
  contactMessages       ContactMessage[]
  newsletterSubscribers NewsletterSubscriber[]
  outfitOptions         OutfitOption[]
  styleLooks            StyleLook[]
  mediaAssets           MediaAsset[]

  @@map("organizations")
}

/// Only two roles exist. SUPER_ADMIN rows always have organizationId = null.
/// ORGANIZATION_ADMIN rows always have organizationId set. The unique
/// constraint on organizationId enforces at most one admin per organization
/// (Postgres unique indexes allow multiple NULLs, so this never restricts
/// how many SUPER_ADMIN rows can exist).
model User {
  id             String        @id @default(cuid())
  organizationId String?       @unique
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String        @unique
  passwordHash   String
  role           UserRole
  status         UserStatus    @default(ACTIVE)
  lastLoginAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  resetTokens        PasswordResetToken[]
  orderStatusChanges OrderStatusHistory[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  /// Always lower-case kebab-case (see utils/slugify.ts), so "Women" and
  /// "women" resolve to the same category.
  slug           String
  parentId       String?
  parent         Category?    @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[]   @relation("CategoryTree")
  /// Display heading on storefront cards (e.g. "For Women's"); falls back to name.
  title          String       @default("")
  description    String       @default("")
  imageUrl       String?
  imageAlt       String       @default("")
  position       Int          @default(0)
  /// Inactive categories are hidden from the storefront but kept for admin use.
  isActive       Boolean      @default(true)
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  products ProductCategory[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([organizationId, isActive, position])
  @@map("categories")
}

model Product {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  slug           String
  description    String        @default("")
  /// Short storefront teaser, also the default meta description.
  summary        String        @default("")
  features       String[]
  vendor         String        @default("")
  productType    String        @default("")
  status         ProductStatus @default(DRAFT)

  price          Float
  compareAtPrice Float?
  costPerItem    Float?
  sku            String?
  barcode        String?

  trackQuantity     Boolean @default(true)
  quantity          Int     @default(0)
  lowStockThreshold Int     @default(5)
  allowBackorder    Boolean @default(false)

  variantOptionNames String[]
  isFeatured         Boolean   @default(false)
  /// Order within the storefront's featured list (lower first).
  featuredPosition   Int?
  /// First time the product was published; drives "new arrivals".
  publishedAt        DateTime?

  seoTitle         String  @default("")
  seoDescription   String  @default("")
  weightKg         Float?
  requiresShipping Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images     ProductImage[]
  variants   ProductVariant[]
  categories ProductCategory[]
  orderItems OrderItem[]

  heroOfLooks StyleLook[]        @relation("LookHeroProduct")
  inLooks     StyleLookProduct[]

  @@unique([organizationId, slug])
  @@unique([organizationId, sku])
  @@index([organizationId, status])
  @@index([organizationId, status, isFeatured, featuredPosition])
  @@index([organizationId, status, price])
  @@map("products")
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String  @default("")
  position  Int     @default(0)

  @@index([productId])
  @@map("product_images")
}

/// options is a JSON array of {name, value} pairs, e.g. [{"name":"Size","value":"M"}].
/// size / color / optionKey are derived from options on every write so they
/// can be filtered and uniquely indexed. organizationId is denormalized from
/// the product so SKUs can be unique per organization.
model ProductVariant {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId         String
  product           Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  title             String
  options           Json
  size              String?
  color             String?
  /// Normalized "color=black|size=s" key; unique per product.
  optionKey         String
  sku               String?
  price             Float?
  compareAtPrice    Float?
  inventoryQuantity Int          @default(0)
  isActive          Boolean      @default(true)
  imageId           String?

  orderItems OrderItem[]

  @@unique([productId, optionKey])
  @@unique([organizationId, sku])
  @@index([productId])
  @@index([organizationId, size])
  @@index([organizationId, color])
  @@map("product_variants")
}

// ---------------------------------------------------------------------------
// Customers & commerce
// ---------------------------------------------------------------------------

/// Customers are created by storefront checkout activity, not admin login.
/// They never receive a User row / session.
model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String
  phone          String?
  address        Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  orders Order[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("customers")
}

model Order {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderNumber    String
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  status         OrderStatus   @default(PENDING)
  paymentStatus  PaymentStatus @default(PENDING)
  /// Customer's chosen method (cod | card | wallet). No payment is collected yet.
  paymentMethod  String        @default("cod")
  currency       String        @default("USD")
  /// Secret handed to the guest at checkout; required to look the order up publicly.
  accessToken    String?       @unique

  shippingName    String
  shippingEmail   String
  shippingPhone   String?
  shippingAddress Json
  billingAddress  Json?
  customerNote    String?

  subtotal Float
  discount Float @default(0)
  shipping Float @default(0)
  tax      Float @default(0)
  total    Float

  trackingNumber String?
  carrier        String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  cancelledAt    DateTime?
  cancelReason   String?
  internalNotes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items         OrderItem[]
  statusHistory OrderStatusHistory[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, shippingEmail])
  @@map("orders")
}

/// Snapshots product/variant data at order time so later edits to a product
/// (name, price) never change historical orders.
model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  productName    String
  productSlug    String?
  variantTitle   String?
  sku            String?
  size           String?
  color          String?
  imageUrl       String?
  quantity       Int
  unitPrice      Float
  compareAtPrice Float?
  discount       Float   @default(0)
  total          Float

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  changedById String?
  changedBy   User?        @relation(fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ---------------------------------------------------------------------------
// Storefront & settings
// ---------------------------------------------------------------------------

model StorefrontConfig {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  storeName       String   @default("")
  logoUrl         String?
  faviconUrl      String?
  primaryColor    String   @default("#111111")
  secondaryColor  String   @default("#f5f5f5")
  fontFamily      String   @default("Inter")
  heroBadgeText   String?
  heroHeadline    String?
  heroSubheadline String?
  heroImageUrl    String?
  heroImageAlt    String   @default("")
  heroCtaLabel    String?
  heroCtaHref     String?
  /// Deprecated: featured products are driven by Product.isFeatured /
  /// featuredPosition. Kept so existing data is not dropped; not exposed by the API.
  featuredProductIds  String[]
  featuredCategoryIds String[]
  footerText          String?
  contactEmail        String?
  contactPhone        String?
  addressLines        String[]
  workingHours        String?
  mapEmbedUrl         String?
  /// { "instagram": "https://...", ... }
  socialLinks         Json?
  siteUrl             String?
  seoTitle            String?
  seoDescription      String?

  announcementEnabled   Boolean @default(false)
  announcementMessage   String?
  announcementHighlight String?
  announcementLinkLabel String?
  announcementLinkHref  String?
  announcementShowPhone Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@map("storefront_configs")
}

model OrganizationSettings {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  currency                 String @default("USD")
  timezone                 String @default("UTC")
  taxRatePercent           Float  @default(0)
  shippingFlatRate         Float  @default(0)
  freeShippingThreshold    Float?
  orderNumberPrefix        String @default("ORD")
  lowStockThresholdDefault Int    @default(5)

  updatedAt DateTime @updatedAt

  @@map("organization_settings")
}

// ---------------------------------------------------------------------------
// Storefront content (CMS)
// ---------------------------------------------------------------------------

model NavigationLink {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location       NavigationLocation
  label          String
  href           String
  position       Int                @default(0)
  isVisible      Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organizationId, location, position])
  @@map("navigation_links")
}

/// Structured page content keyed by page (currently "about"). The JSON shape is
/// validated per key in lib/server/content.ts.
model PageContent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  content        Json
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, key])
  @@map("page_contents")
}

model TeamMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  role           String       @default("")
  imageUrl       String?
  position       Int          @default(0)
  isVisible      Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, position])
  @@map("team_members")
}

// ---------------------------------------------------------------------------
// Blog
// ---------------------------------------------------------------------------

model BlogCategory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  createdAt      DateTime     @default(now())

  posts BlogPost[]

  @@unique([organizationId, slug])
  @@map("blog_categories")
}

model BlogPost {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  slug           String
  excerpt        String        @default("")
  /// Markdown body.
  content        String        @default("")
  coverImageUrl  String?
  coverImageAlt  String        @default("")
  authorName     String        @default("")
  categoryId     String?
  category       BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  status         ContentStatus @default(DRAFT)
  isFeatured     Boolean       @default(false)
  publishedAt    DateTime?
  seoTitle       String        @default("")
  seoDescription String        @default("")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId, status, publishedAt(sort: Desc)])
  @@map("blog_posts")
}

// ---------------------------------------------------------------------------
// Inbox & newsletter
// ---------------------------------------------------------------------------

model ContactMessage {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String
  phone          String?
  subject        String
  message        String
  status         ContactMessageStatus @default(NEW)
  internalNote   String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([organizationId, status, createdAt])
  @@map("contact_messages")
}

model NewsletterSubscriber {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Stored trimmed and lower-cased.
  email          String
  status         SubscriberStatus @default(SUBSCRIBED)
  source         String           @default("website")
  consentAt      DateTime         @default(now())
  unsubscribedAt DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([organizationId, email])
  @@index([organizationId, status, createdAt])
  @@map("newsletter_subscribers")
}

// ---------------------------------------------------------------------------
// Outfit Finder
// ---------------------------------------------------------------------------

/// One row per selectable quiz option (body type, skin tone or occasion).
model OutfitOption {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           OutfitOptionType
  key            String
  label          String
  /// #RRGGBB, skin tones only.
  hex            String?
  imageUrl       String?
  position       Int              @default(0)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  looksForOccasion StyleLook[]          @relation("LookOccasion")
  lookConditions   StyleLookCondition[]

  @@unique([organizationId, type, key])
  @@index([organizationId, type, position])
  @@map("outfit_options")
}

/// A curated look returned by the Outfit Finder for an occasion, optionally
/// restricted to specific body types / skin tones (no restriction = any).
model StyleLook {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  occasionId     String
  occasion       OutfitOption @relation("LookOccasion", fields: [occasionId], references: [id], onDelete: Cascade)
  styleName      String
  description    String       @default("")
  tags           String[]
  heroProductId  String?
  heroProduct    Product?     @relation("LookHeroProduct", fields: [heroProductId], references: [id], onDelete: SetNull)
  position       Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  conditions StyleLookCondition[]
  products   StyleLookProduct[]

  @@index([organizationId, occasionId, isActive])
  @@map("style_looks")
}

/// Body-type / skin-tone restrictions of a look.
model StyleLookCondition {
  lookId   String
  look     StyleLook    @relation(fields: [lookId], references: [id], onDelete: Cascade)
  optionId String
  option   OutfitOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([lookId, optionId])
  @@map("style_look_conditions")
}

/// "Complete the look" products, ordered.
model StyleLookProduct {
  lookId    String
  look      StyleLook @relation(fields: [lookId], references: [id], onDelete: Cascade)
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  position  Int       @default(0)

  @@id([lookId, productId])
  @@map("style_look_products")
}

// ---------------------------------------------------------------------------
// Media
// ---------------------------------------------------------------------------

/// Uploaded images are stored in Postgres and served publicly from
/// GET /media/{id}. This needs no extra infrastructure; swap for object
/// storage (S3/R2/Blob) if volume grows.
model MediaAsset {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  filename       String
  mimeType       String
  sizeBytes      Int
  data           Bytes
  alt            String       @default("")
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@map("media_assets")
}
